e":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\privacy-short\\voice\\a2c3ae1a68c5c966.wav","t":22.2556496},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\privacy-short\\voice\\0659d6292a5ad7ca.wav","t":26.0636497},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\privacy-short\\voice\\e83500b59c121679.wav","t":27.3807479},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\privacy-short\\voice\\61e1f696a34e77d6.wav","t":31.2418775},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\privacy-short\\voice\\c9ee8fafc9905871.wav","t":38.315528799999996},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\privacy-short\\voice\\7a02f1a952bf2a92.wav","t":39.5064112}],"captions":[{"text":"Your job search is personal.","start":0.3509387999999998,"end":1.9356814999999994},{"text":"Here's how Job Explorer keeps it that way.","start":2.1162834000000004,"end":4.241141899999999},{"text":"It can run its AI right on your computer, with Ollama.","start":5.0981623,"end":8.0957459},{"text":"Your resume never goes to an AI service, and it's free.","start":8.2779916,"end":11.3941794},{"text":"Prefer a cloud AI?","start":12.2508929,"end":13.4788983},{"text":"Your name, email, phone, and address are never sent to any AI.","start":13.6651572,"end":17.332250900000002},{"text":"Everything is stored encrypted, with a key your Windows sign-in protects.","start":18.1999764,"end":22.068082800000003},{"text":"There's no account, and nothing is sent to the app's maker.","start":22.2556563,"end":25.2021155},{"text":"Want a second lock?","start":26.063654500000002,"end":27.2001104},{"text":"Turn on a master password, and nothing opens without it.","start":27.3807561,"end":30.381293},{"text":"And back up everything to one password-protected file, for a USB drive or your own cloud storage.","start":31.241879599999997,"end":37.4574158},{"text":"Job Explorer.","start":38.315531299999996,"end":39.3232135},{"text":"Get it on the Microsoft Store.","start":39.5064139,"end":41.121782700000004}]}