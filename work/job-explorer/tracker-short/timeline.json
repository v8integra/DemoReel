oice\\c9ee8fafc9905871.wav","t":33.638279700000005},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\tracker-short\\voice\\7a02f1a952bf2a92.wav","t":34.8227907}],"captions":[{"text":"Applied to a dozen jobs, and already lost track?","start":0.35203260000000025,"end":3.1361180000000006},{"text":"Here's a better way.","start":3.3182777999999997,"end":4.3396606},{"text":"When you apply for a job, mark it applied.","start":5.1979808,"end":7.496373200000001},{"text":"It goes straight to your Tracker.","start":7.675271199999999,"end":9.1063209},{"text":"Every application, the date you applied, and where it stands, all in one list.","start":9.965802600000002,"end":14.1510435},{"text":"Heard back?","start":15.0109594,"end":15.7583986},{"text":"Update the status in one tap, from applied, to interviewing, to an offer.","start":15.950005099999998,"end":19.9654795},{"text":"Open any application for its notes, contacts, and full history.","start":20.8187766,"end":24.5158521},{"text":"And if a company goes quiet, Job Explorer drafts a polite follow-up email, for you to check and send yourself.","start":26.3603877,"end":32.778004100000004},{"text":"Job Explorer.","start":33.638281299999996,"end":34.6348604},{"text":"Get it on the Microsoft Store.","start":34.822794599999995,"end":36.4374137}]}