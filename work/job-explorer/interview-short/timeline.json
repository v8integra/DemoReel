\\DemoReel\\work\\job-explorer\\interview-short\\voice\\4943a18601d350d0.wav","t":9.532149599999997},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\interview-short\\voice\\fc62f85d4f6f4f2b.wav","t":10.907908599999999},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\interview-short\\voice\\247fd0bb808ab5a7.wav","t":16.80715550000002},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\interview-short\\voice\\48f17c75b68f67e8.wav","t":21.8441167},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\interview-short\\voice\\a80baa1f6c6b7b95.wav","t":27.900279300000022},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\interview-short\\voice\\a8d267e8d9dccdad.wav","t":29.685613200000006},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\interview-short\\voice\\c9ee8fafc9905871.wav","t":32.51618750000003},{"file":"C:\\Users\\Raven\\Desktop\\Projects\\DemoReel\\work\\job-explorer\\interview-short\\voice\\7a02f1a952bf2a92.wav","t":33.7055421}],"captions":[{"text":"Got the interview?","start":0.3521006999999976,"end":1.2846200000000003},{"text":"Here's how to walk in ready.","start":1.4651154000000002,"end":2.8402823999999995},{"text":"Tap interview prep on the job.","start":3.7067201999999995,"end":5.361532799999999},{"text":"Job Explorer reads the posting, and your own profile.","start":5.550681599999999,"end":8.666740599999997},{"text":"Then it writes your prep.","start":9.5321541,"end":10.725415299999998},{"text":"Anything it can't back up from your profile is taken out.","start":10.9079142,"end":13.806813199999997},{"text":"You get the questions they're likely to ask, and why, straight from the posting.","start":16.807159900000016,"end":20.976093300000002},{"text":"Then talking points, tied to what you've actually done, so every answer has a real example.","start":21.84412260000002,"end":27.03879170000002},{"text":"And good questions to ask them.","start":27.900286300000005,"end":29.504464900000016},{"text":"Save it as a PDF, and you're ready.","start":29.68561490000002,"end":31.664036600000003},{"text":"Job Explorer.","start":32.516189200000014,"end":33.52497690000001},{"text":"Get it on the Microsoft Store.","start":33.705545400000034,"end":35.309848200000005}]}